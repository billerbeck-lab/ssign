# ssign v1.0.0 Singularity/Apptainer definition (default reproducible artifact).
#
# Build from the REPO ROOT (so the %files paths resolve):
#   apptainer build ssign.sif containers/ssign.def
# (unprivileged: Apptainer 1.x builds via user namespaces / --fakeroot.)
#
# Run (offline golden smoke, no DBs needed — DeepLocPro is baked in):
#   apptainer run --writable-tmpfs --containall -B <outdir>:/work \
#     ssign.sif run <genome.gbff> --outdir /work \
#       --use-input-annotations \
#       --skip-deepsece --skip-signalp --skip-annotation
#
# The free toolchain is BAKED: Bakta 1.12.0 + its binary deps (tRNAscan-SE,
# aragorn, INFERNAL, PilerCR, AMRFinderPlus, DIAMOND, real HMMER, BLAST+ 2.17) and
# EggNOG-mapper live in two micromamba envs on PATH; DeepLocPro (the default-on
# localization predictor, open source) + its ESM2 backbone, the DeepSecE checkpoint
# (fine-tuned ESM-1b), and the pLM-BLAST ProtT5 encoder are baked into ssign's env
# and caches, so the default path runs fully offline. Only two things stay host-provided:
#   * SignalP 6 (DTU academic licence — cannot be bundled) — install locally with
#     scripts/ssign-setup-dtu, or run with --signalp-mode remote. It is the ONLY
#     predictor not baked.
#   * reference databases/weights (licence + up to 500 GB) — bind the host DB dir;
#     Apptainer passes host SSIGN_* env vars through, so `export SSIGN_*_DB=...` works.
# LICENCE: baking DeepLocPro (CC BY-NC-SA 4.0) makes this image NON-COMMERCIAL
# (academic/research use). See %labels/%help.

Bootstrap: docker
# Digest locked 2026-07-10 for tag 12.4.1-runtime-ubuntu22.04. Apptainer rejects
# a combined tag@digest reference, so pin by digest only (the digest IS the pin).
# Re-pin from Docker Hub if a base CVE forces it; this is what makes it deterministic.
From: nvidia/cuda@sha256:517da2300c184c9999ec203c2665244bdebd3578d12fcc7065e83667932643d9

%files
    pyproject.toml /opt/ssign/pyproject.toml
    uv.lock /opt/ssign/uv.lock
    README.md /opt/ssign/README.md
    LICENSE /opt/ssign/LICENSE
    src /opt/ssign/src
    scripts /opt/ssign/scripts

%post
    # Fail-fast: Apptainer only checks %post's final exit code, so without this a
    # mid-build failure (a blipped download, a bad conda solve) can be masked by a
    # later command succeeding and bake a silently-broken image. dash (/bin/sh) has
    # no `pipefail`, but `set -e` alone suffices here (a failed download yields empty
    # input and the consuming command then fails, aborting the build).
    set -e
    export DEBIAN_FRONTEND=noninteractive
    # openjdk-11-jre-headless: InterProScan's interproscan.sh shells out to
    # `java`, which must be on the container PATH under --containall. Java 11
    # matches the validated native CX3 path (module Java/11.0.25).
    # ncbi-blast+ is intentionally NOT installed here: the baked bakta env below
    # ships BLAST+ 2.17 (the version Bakta 1.12.0 requires), which also serves the
    # BLASTp annotation step. The old apt blast (2.12, 2022) was too stale for Bakta.
    # rsync: the DB-staging helper (ssign_lib/resources.py) rsyncs network-mounted
    # DB trees (InterProScan member DBs, pLM-BLAST ECOD, Bakta, HH-suite) to fast
    # node-local SSD before use. Without it, staging silently skips and tools run
    # off the network mount, InterProScan then SIGBUS-crashes on mmap over RDS/NFS.
    apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-venv python3-pip python3-dev build-essential \
        wget tar unzip bzip2 git ca-certificates libgomp1 rsync \
        openjdk-11-jre-headless \
        && rm -rf /var/lib/apt/lists/*

    # --- Baked free toolchain (micromamba envs) --------------------------------
    # Bakta and EggNOG-mapper shell out to binary tools that are NOT pip-installable
    # (tRNAscan-SE, aragorn, INFERNAL, PilerCR, AMRFinderPlus, DIAMOND, real HMMER,
    # BLAST+ 2.17). Baking them makes extended/full runs self-contained: a user
    # provides ONLY the DTU licence tools + reference databases, never a host conda
    # env. Two isolated envs at fixed paths, kept apart so EggNOG's biopython==1.76
    # pin cannot collide with ssign's biopython>=1.80. Solved EARLY (before the heavy
    # torch pip layer) so a bad solve fails the build in minutes, not after an hour.
    #
    # micromamba is fetched at `latest` for this first build; the reproducibility pin
    # that matters is the per-package solve, frozen to /opt/conda/*.lock.yml below
    # (re-pin micromamba itself from the recorded build log at close-out).
    export MAMBA_ROOT_PREFIX=/opt/conda
    wget -qO- https://micro.mamba.pm/api/micromamba/linux-64/latest \
        | tar -xj -C /usr/local bin/micromamba
    # conda-forge before bioconda + strict priority is the bioconda-mandated channel
    # order; the version pins make each solve deterministic.
    micromamba create -y -p /opt/conda/envs/bakta \
        -c conda-forge -c bioconda --channel-priority strict bakta=1.12.0
    micromamba create -y -p /opt/conda/envs/eggnog \
        -c conda-forge -c bioconda --channel-priority strict eggnog-mapper=2.1.13
    # HH-suite (full tier): run_hhsuite.py shells out to `hhblits` + `hhsearch`
    # on PATH. Its own isolated env so the C++ toolchain can't perturb the
    # validated bakta/eggnog solves. The DBs (Pfam/PDB70/UniRef30, ~340 GB) stay
    # host-mounted (SSIGN_HHSUITE_*); only the software is baked.
    micromamba create -y -p /opt/conda/envs/hhsuite \
        -c conda-forge -c bioconda --channel-priority strict hhsuite=3.3.0
    # Freeze the exact solved versions inside the image (reproducibility lock).
    micromamba env export -p /opt/conda/envs/bakta   > /opt/conda/bakta.lock.yml
    micromamba env export -p /opt/conda/envs/eggnog  > /opt/conda/eggnog.lock.yml
    micromamba env export -p /opt/conda/envs/hhsuite > /opt/conda/hhsuite.lock.yml
    # Build-time gate: the two binaries the wrapper invokes must resolve.
    command -v /opt/conda/envs/hhsuite/bin/hhblits >/dev/null \
        && command -v /opt/conda/envs/hhsuite/bin/hhsearch >/dev/null \
        || { echo "FATAL: hhsuite env missing hhblits/hhsearch"; exit 1; }
    # Drop package tarballs + solver caches (several GB) so they don't bloat the image.
    micromamba clean -y --all
    rm -rf /opt/conda/pkgs

    # Pinned install: export the frozen uv.lock to a requirements file, install
    # exactly that, then ssign --no-deps. `--locked` fails the build if uv.lock
    # is stale vs pyproject.toml (rather than silently omitting deps).
    cd /opt/ssign
    python3 -m pip install --upgrade pip setuptools wheel uv
    uv export --locked --extra extended --no-hashes --no-emit-project -o /tmp/requirements.lock.txt
    python3 -m pip install --no-cache-dir -r /tmp/requirements.lock.txt
    python3 -m pip install --no-cache-dir --no-deps .

    # pLM-BLAST (extended/full). run_plm_blast.py invokes it as
    # `sys.executable plmblast.py`, so it runs under ssign's own Python; its
    # whole runtime stack (torch/transformers/numba/scikit-learn) is already in
    # the pinned env above, so no extra pip install is needed. Clone a pinned
    # commit for reproducibility. The wrapper prepends the repo root to
    # PYTHONPATH at run time so the in-repo `alntools` package resolves. The
    # ECOD database is host-mounted separately (SSIGN_ECOD_DB), not baked.
    git clone https://github.com/labstructbioinf/pLM-BLAST.git /opt/pLM-BLAST
    git -C /opt/pLM-BLAST checkout 4dddea3cf70fa60ece8c4dc6e454b7799887fa28
    rm -rf /opt/pLM-BLAST/.git

    # Bake TXSScan HMM profiles so the run is offline. The runner looks for them
    # under $HOME/.macsyfinder (runner.py); we pin HOME to /opt/ssign_home (set in
    # %environment) and install there, so the runtime check passes without a
    # network install. Pin matches runner.py.
    export HOME=/opt/ssign_home
    mkdir -p /opt/ssign_home
    macsydata install --user TXSScan==1.1.4

    # --- Build-weight cache (#36): reuse the ~10 GB of model downloads across
    # rebuilds. Bind a host dir with `apptainer build --bind DIR:/build_cache`
    # (build_sif.sh does this from $SSIGN_BUILD_CACHE). If present, PRE-SEED the
    # image caches from it so the esm/DeepSecE/ProtT5 fetches below become no-ops
    # (each checks its cache before downloading); the results are copied BACK after
    # the bakes so the next rebuild reuses them. Absent -> everything downloads as
    # before, so the build stays self-contained. cp -a preserves the exact layout
    # torch.hub / huggingface_hub / _ensure_checkpoint expect.
    BUILD_CACHE=/build_cache
    if [ -d "$BUILD_CACHE" ]; then
        echo "[#36] build-weight cache present -> pre-seeding image caches"
        mkdir -p /opt/ssign_home/.cache /opt/ssign_home/.ssign
        [ -e "$BUILD_CACHE/torch" ]       && cp -a "$BUILD_CACHE/torch"       /opt/ssign_home/.cache/ || true
        [ -e "$BUILD_CACHE/huggingface" ] && cp -a "$BUILD_CACHE/huggingface" /opt/ssign_home/.cache/ || true
        [ -e "$BUILD_CACHE/models" ]      && cp -a "$BUILD_CACHE/models"      /opt/ssign_home/.ssign/ || true
    fi

    # --- DeepLocPro (baked) ----------------------------------------------------
    # DeepLocPro is the DEFAULT-ON localization predictor. Unlike the DTU-licensed
    # SignalP it is open source (public GitHub, CC BY-NC-SA 4.0 — see the licence
    # note in %labels/%help; this is why the image is non-commercial), so it CAN be
    # baked. Installed --no-deps into ssign's own env: its deps (torch, fair-esm,
    # numpy, pandas, biopython, matplotlib) are all in the pinned uv.lock stack, so
    # the pinned versions are untouched. Pinned commit for reproducibility; this
    # also MIRRORS the repo into the image so it survives if upstream disappears.
    git clone https://github.com/Jaimomar99/deeplocpro.git /opt/deeplocpro-src
    git -C /opt/deeplocpro-src checkout 32c0b37c7a31a0686ce022a697f48998fc2997b1
    rm -rf /opt/deeplocpro-src/.git
    python3 -m pip install --no-cache-dir --no-deps /opt/deeplocpro-src
    # Bake the ~2.5 GB ESM2-650M backbone DeepLocPro needs into the image torch
    # cache (HOME=/opt/ssign_home here), so the default localization path runs
    # fully offline. Explicit — don't rely on DeepLocPro's atexit install hook,
    # which may run in pip's isolated build subprocess and not persist.
    python3 -c "import esm; esm.pretrained.load_model_and_alphabet('esm2_t33_650M_UR50D')"
    # Build-time gate: confirm the baked DeepLocPro actually runs under the pinned
    # torch. If this fails, the shared-env assumption is wrong and it must move to
    # its own micromamba env (like bakta/eggnog).
    deeplocpro -h >/dev/null 2>&1 || { echo "FATAL: baked deeplocpro fails under torch $(python3 -c 'import torch;print(torch.__version__)')"; exit 1; }

    # --- DeepSecE checkpoint + pLM-BLAST ProtT5 encoder (baked) -----------------
    # The last two lazy runtime downloads on the default path. Baking them makes a
    # first run identical to every run (zero network, fully offline):
    #   * DeepSecE is default-on (it is in constants._BASE_ENABLED); run_deepsece.py
    #     otherwise pulls a ~2.5 GB fine-tuned ESM-1b checkpoint on first run. Call
    #     its own _ensure_checkpoint() (single source of truth) so the build inherits
    #     the Zenodo-primary/SJTU-fallback URL list + the ~100 MB truncation gate,
    #     and auto-follows CHECKPOINT_URL_ZENODO once v1.0.0 populates it. It raises
    #     on failure, which set -e turns into a build abort. Override the source at
    #     build time with SSIGN_DEEPSECE_CHECKPOINT_URL.
    #   * pLM-BLAST embeds queries with the ProtT5 encoder
    #     Rostlab/prot_t5_xl_half_uniref50-enc via a HF from_pretrained with no
    #     pre-staged cache (~2.4 GB, weights + tokenizer). Seed the HF hub cache so
    #     T5Tokenizer/T5EncoderModel.from_pretrained resolve offline.
    # HOME is still /opt/ssign_home here, so both land in the baked profile/caches.
    python3 -c "from ssign_app.scripts.run_deepsece import _ensure_checkpoint; _ensure_checkpoint()"
    # The 100 MB size floor _ensure_checkpoint applies can still pass a silently
    # truncated download from the flaky SJTU mirror, which would then fail at runtime
    # on every (default-on) DeepSecE run. torch.load it here (same weights_only=False
    # the runtime uses, since the ESM checkpoint carries non-tensor globals) so a
    # truncated/corrupt checkpoint aborts the BUILD instead. TODO(v1.0.0): also pin a
    # SHA-256 of the checksummed Zenodo artifact to catch a mirror serving different-
    # but-valid weights (integrity, not just loadability).
    python3 -c "import torch; from ssign_app.scripts.run_deepsece import DEFAULT_CHECKPOINT; torch.load(DEFAULT_CHECKPOINT, map_location='cpu', weights_only=False); print('DeepSecE checkpoint verified loadable', flush=True)"
    # DeepSecE's model ALSO loads the ESM-1b backbone (esm1b_t33_650M_UR50S, ~7.3 GB)
    # via esm.pretrained to build its architecture, separate from the checkpoint
    # above. Un-baked, it downloads at runtime into the small tmpfs overlay and dies
    # with "No space left on device". Bake it into the image torch cache (HOME set
    # above), like DeepLocPro's ESM2, so DeepSecE runs fully offline.
    python3 -c "import esm; esm.pretrained.esm1b_t33_650M_UR50S()"

    # Seed the ProtT5 encoder (weights + tokenizer) into the HF hub cache so that at
    # run time pLM-BLAST's T5Tokenizer/T5EncoderModel.from_pretrained resolve fully
    # offline. snapshot_download needs no torch/sentencepiece load. Pin the commit so
    # a rebuild bakes identical weights (this image bills itself as reproducible).
    # pLM-BLAST calls from_pretrained with the DEFAULT revision 'main', which offline
    # mode resolves via refs/main; a commit-pinned snapshot writes no such ref, so we
    # point refs/main at the pinned commit (reproducible AND offline-resolvable).
    unset HF_HUB_OFFLINE TRANSFORMERS_OFFLINE  # a host-exported offline flag would break the fetch
    python3 - <<'PY'
import os, sys
from huggingface_hub import snapshot_download
REPO = "Rostlab/prot_t5_xl_half_uniref50-enc"
REV = "94a6abc029ae13029317b140b7424e012bf8dfbf"
snapshot_download(REPO, revision=REV)
cache = os.path.join(os.path.expanduser("~"), ".cache", "huggingface", "hub",
                     "models--Rostlab--prot_t5_xl_half_uniref50-enc")
refs = os.path.join(cache, "refs")
os.makedirs(refs, exist_ok=True)
with open(os.path.join(refs, "main"), "w") as fh:
    fh.write(REV)
# Size gate: sum the real blobs (skip the symlinks under snapshots/<rev>/).
total = sum(os.path.getsize(os.path.join(r, f))
            for r, _d, fs in os.walk(cache) for f in fs
            if not os.path.islink(os.path.join(r, f)))
if total < 1_000_000_000:
    sys.exit("FATAL: ProtT5 encoder not baked (%d bytes)" % total)
print("ProtT5 encoder baked: %d bytes; refs/main -> %s" % (total, REV), flush=True)
PY

    # Copy the freshly-baked weights BACK to the bound cache (#36) so the next
    # rebuild pre-seeds from it and skips the downloads. No-op / harmless when the
    # cache was already seeded (same bytes) or bound read-only (|| true).
    if [ -d "$BUILD_CACHE" ]; then
        echo "[#36] refreshing build-weight cache for next rebuild"
        cp -a /opt/ssign_home/.cache/torch       "$BUILD_CACHE/" 2>/dev/null || true
        cp -a /opt/ssign_home/.cache/huggingface "$BUILD_CACHE/" 2>/dev/null || true
        cp -a /opt/ssign_home/.ssign/models      "$BUILD_CACHE/" 2>/dev/null || true
    fi

    # Default mount points for host-provided databases/weights + work dir.
    mkdir -p /opt/ssign_home/.ssign/databases /opt/ssign_home/.ssign/models /work
    chmod -R a+rX /opt/ssign_home

%environment
    export LANG=C.UTF-8 LC_ALL=C.UTF-8
    export PYTHONUNBUFFERED=1
    # Pin HOME to the baked profile/config location so TXSScan + ~/.ssign resolve
    # regardless of the host user. Runtime writes (caches) need --writable-tmpfs.
    export HOME=/opt/ssign_home
    # Baked toolchain envs on PATH so Bakta (+ its tRNAscan/aragorn/diamond/
    # amrfinder/real-HMMER/BLAST+ 2.17) and EggNOG's emapper.py resolve under
    # --containall with NO host conda-env mount. bakta first also gives MacSyFinder
    # a real hmmsearch (ssign's pyhmmer stand-in stays a harmless fallback). ssign's
    # own scripts run via sys.executable (absolute), so the conda `python` on PATH
    # never shadows them. Mirrors the validated native CX3 prepend.
    # hhsuite last (unique binary names hhblits/hhsearch, no shadowing risk).
    export PATH=/opt/conda/envs/bakta/bin:/opt/conda/envs/eggnog/bin:/opt/conda/envs/hhsuite/bin:$PATH
    # Baked pLM-BLAST clone (extended/full). Default-only (`:-`) so a
    # user-supplied SSIGN_PLMBLAST_SCRIPT (e.g. --env at run time) still wins.
    export SSIGN_PLMBLAST_SCRIPT=${SSIGN_PLMBLAST_SCRIPT:-/opt/pLM-BLAST/scripts/plmblast.py}
    # pLM-BLAST's alntools uses numba @njit(cache=True), which by default writes
    # its cache next to the source file — read-only in the image, so `import
    # alntools` raises "no locator available". Redirect the numba cache to a
    # writable tmpdir (/tmp is a private tmpfs under --containall). Default-only.
    export NUMBA_CACHE_DIR=${NUMBA_CACHE_DIR:-/tmp/ssign_numba_cache}
    # Everything a default run needs is baked (ESM2, DeepSecE checkpoint, ProtT5
    # encoder), so default to HF offline: transformers reads the baked hub cache
    # without probing the network or writing lock files into the read-only image
    # (this is what makes pLM-BLAST's ProtT5 load fully offline). Default-only, so a
    # user wanting live HF downloads (e.g. a future un-baked model) sets BOTH
    # HF_HUB_OFFLINE and TRANSFORMERS_OFFLINE to 0 (transformers honours either).
    export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
    export TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE:-1}

%runscript
    exec ssign "$@"

%labels
    org.opencontainers.image.title ssign
    org.opencontainers.image.description Secretion-system Identification for Gram-negative bacterial genomes
    org.opencontainers.image.source https://github.com/billerbeck-lab/ssign
    # ssign itself is GPL-3.0-or-later. The image also BUNDLES DeepLocPro
    # (CC-BY-NC-SA-4.0, non-commercial) and EggNOG-mapper (AGPL-3.0-or-later) as
    # aggregated tools, so the image as a whole is for NON-COMMERCIAL research use.
    org.opencontainers.image.licenses GPL-3.0-or-later AND CC-BY-NC-SA-4.0 AND AGPL-3.0-or-later
    org.opencontainers.image.version 1.0.0

%help
    ssign v1.0.0 — reproducible Singularity image. Databases/weights are
    bind-mounted (not bundled). SignalP 6 (DTU licence) is the only predictor not
    baked: install it with scripts/ssign-setup-dtu or use --signalp-mode remote.
    See containers/README.md for per-tier mounts and HPC usage.

    LICENCE: this image bundles DeepLocPro (CC BY-NC-SA 4.0) and EggNOG-mapper
    (AGPL), so it is for NON-COMMERCIAL academic/research use. ssign's own code is
    GPL-3.0-or-later. `apptainer run ssign.sif --help`.
