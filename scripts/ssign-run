#!/usr/bin/env bash
# ssign-run: one-line launcher for the ssign Singularity/Apptainer container.
#
# The image bakes the entire free toolchain (Bakta 1.12.0 + its binary deps,
# EggNOG-mapper, BLAST+ 2.17, MacSyFinder, pLM-BLAST, real HMMER, ...). You
# supply only what genuinely cannot be bundled:
#   * a genome file (GenBank / GFF3 / FASTA)
#   * for extended/full: the reference-database root (fetch_databases.sh output)
#   * SignalP 6 (the only predictor not baked; DeepLocPro is baked in). Provide it
#     via --signalp-env, or install it with ssign-setup-dtu (auto-detected after);
#     without it the run stops at the SignalP step unless you add
#     `-- --signalp-mode remote`.
#
# This wrapper is host-agnostic: no PBS, no cluster paths. It builds the
# `apptainer run` command, binds the un-bakeable bits at their real paths, points
# ssign at them, and routes scratch onto real disk (the container's default
# --writable-tmpfs /tmp is only 64 MiB, too small for Bakta).
#
# Usage:
#   ssign-run GENOME OUTDIR [options] [-- extra `ssign run` args...]
#
# Positional:
#   GENOME                 input genome (GenBank / GFF3 / FASTA)
#   OUTDIR                 output directory (created if absent)
#
# Options:
#   --sif PATH             image file            (default: $SSIGN_SIF or ./ssign.sif)
#   --tier base|extended|full                    (default: extended)
#   --db-root DIR          reference DB root     (required for extended/full)
#   --signalp-env DIR      conda env with bin/signalp6 (the only predictor not baked).
#                          Omit and it is auto-detected from your conda envs (after
#                          ssign-setup-dtu); or add `-- --signalp-mode remote`.
#   --deeplocpro-env DIR   conda env with bin/deeplocpro, OPTIONAL: DeepLocPro is baked
#                          into the image; only pass this to override with your own build
#   --torch-cache DIR      host torch cache to mount (only for persisting DeepSecE's ESM1b;
#                          NOT needed for DeepLocPro, its ESM2 is baked)
#   --scratch DIR          real-disk scratch bound onto /tmp (default: OUTDIR/.ssign_scratch)
#   --stage-image          copy the .sif to fast local disk (next to --scratch) before
#                          running. Use on HPC when the image sits on a slow/network
#                          filesystem: it turns a long import-startup into one copy.
#   --cpu                  run without a GPU (drops --nv)
#   --max-ram GB           RAM budget passed into the container (sizes tool heaps /
#                          EggNOG --dbmem). REQUIRED on schedulers that hide the
#                          allocation from --containall (e.g. PBS): pass your job's
#                          RAM, else ssign reads the whole node and may OOM. Defaults
#                          from $SSIGN_MAX_RAM_GB, then SLURM_MEM_PER_NODE.
#   --doctor               verify the install instead of running: bind the DBs +
#                          SignalP env and run `ssign doctor --tier <tier>` (no
#                          genome/OUTDIR needed). Exits non-zero on any failure, so
#                          `ssign-run --doctor ... && ssign-run genome ...` gates a job.
#   -h, --help             show this help
#   --                     pass everything after it straight to `ssign run`
#
# Example (extended tier, DeepLocPro baked; provide SignalP + DBs):
#   ssign-run genome.gbff out --tier extended \
#     --db-root /data/ssign-databases \
#     --signalp-env ~/.conda/envs/signalp6
#
# Verify the install (no genome needed):
#   ssign-run --doctor --tier extended --db-root /data/ssign-databases

set -euo pipefail

die()  { echo "ssign-run: $*" >&2; exit 1; }
usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

SIF="${SSIGN_SIF:-./ssign.sif}"
TIER="extended"
DBROOT=""
DLPENV=""
SP6ENV=""
SCRATCH=""
TORCH_CACHE=""
STAGE_IMAGE=0
USE_NV=1
MAXRAM="${SSIGN_MAX_RAM_GB:-}"
GENOME=""
OUTDIR=""
DOCTOR=0
NV_FLAG=()
PASSTHRU=()

# --- parse args -------------------------------------------------------------
POSITIONAL=()
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)        usage 0 ;;
        --sif)            SIF="$2"; shift 2 ;;
        --tier)           TIER="$2"; shift 2 ;;
        --db-root)        DBROOT="$2"; shift 2 ;;
        --deeplocpro-env) DLPENV="$2"; shift 2 ;;
        --signalp-env)    SP6ENV="$2"; shift 2 ;;
        --torch-cache)    TORCH_CACHE="$2"; shift 2 ;;
        --stage-image)    STAGE_IMAGE=1; shift ;;
        --scratch)        SCRATCH="$2"; shift 2 ;;
        --max-ram)        MAXRAM="$2"; shift 2 ;;
        --cpu)            USE_NV=0; shift ;;
        --doctor)         DOCTOR=1; shift ;;
        --)               shift; PASSTHRU=("$@"); break ;;
        -*)               die "unknown option: $1 (use --help)" ;;
        *)                POSITIONAL+=("$1"); shift ;;
    esac
done
# --doctor verifies the install (no genome/outdir); a normal run needs both.
if [ "$DOCTOR" -eq 0 ]; then
    [ "${#POSITIONAL[@]}" -ge 2 ] || usage 1
    GENOME="${POSITIONAL[0]}"
    OUTDIR="${POSITIONAL[1]}"
fi

# --- validate ---------------------------------------------------------------
command -v apptainer >/dev/null || die "apptainer not on PATH (install it, or 'module load apptainer')"
[ "$DOCTOR" -eq 1 ] || [ -f "$GENOME" ] || die "genome not found: $GENOME"
[ -f "$SIF" ]    || die "image not found: $SIF (pass --sif or set \$SSIGN_SIF)"
case "$TIER" in base|extended|full) ;; *) die "invalid --tier '$TIER' (base|extended|full)" ;; esac
if [ "$TIER" != "base" ] && [ -z "$DBROOT" ]; then
    die "--db-root is required for tier '$TIER' (run fetch_databases.sh --tier $TIER first)"
fi
[ -z "$DBROOT" ] || [ -d "$DBROOT" ] || die "db-root not a directory: $DBROOT"

# Genome I/O, scratch, image staging and GPU are run-only; --doctor skips them
# (it only inspects the image + bound databases, needs no genome or GPU).
if [ "$DOCTOR" -eq 0 ]; then
    GENOME=$(readlink -f "$GENOME")
    mkdir -p "$OUTDIR"; OUTDIR=$(readlink -f "$OUTDIR")
    SCRATCH="${SCRATCH:-$OUTDIR/.ssign_scratch}"; mkdir -p "$SCRATCH"; SCRATCH=$(readlink -f "$SCRATCH")

    # --- optional image staging ---------------------------------------------
    # On HPC a .sif on a slow/network filesystem is read as thousands of small
    # squashfs/Python-import reads, which can add tens of minutes of pure startup.
    # --stage-image copies it once to fast local disk (a sibling of --scratch, so
    # point --scratch at node-local storage) and runs from there. Falls back to
    # the original path if the copy fails.
    if [ "$STAGE_IMAGE" -eq 1 ]; then
        stage_dir="${SCRATCH}.img"; mkdir -p "$stage_dir"
        local_sif="$stage_dir/$(basename "$SIF")"
        echo "ssign-run: staging image to $local_sif (one-time copy for faster startup)"
        if cp "$SIF" "$local_sif" 2>/dev/null; then
            SIF="$local_sif"
        else
            echo "ssign-run: staging failed; running from $SIF" >&2
        fi
    fi

    # --- GPU ----------------------------------------------------------------
    if [ "$USE_NV" -eq 1 ]; then
        if command -v nvidia-smi >/dev/null && nvidia-smi -L >/dev/null 2>&1; then
            NV_FLAG=(--nv)
        else
            echo "ssign-run: no GPU detected, running CPU-only (predictors will be slower)" >&2
        fi
    fi
fi

# --- databases: set the SSIGN_* vars ssign reads INSIDE the container -------
# Under --containall the host environment is not forwarded, so use the
# APPTAINERENV_ prefix (Apptainer strips it and sets the bare var inside). Each
# is set only when the matching sub-tree exists under --db-root, so a base run
# (no DBs) or a partially-populated root simply skips the ones it lacks.
BINDS=()
if [ -n "$DBROOT" ]; then
    DBROOT=$(readlink -f "$DBROOT")
    # $DBROOT is bound rw (no :ro): InterProScan's launcher writes scratch under
    # its own install dir, and Bakta may touch its DB dir.
    BINDS+=( -B "$DBROOT":"$DBROOT" )
    _ecod=$(ls -d "$DBROOT"/plm_blast/ECOD* 2>/dev/null | head -1 || true)
    _ips=$(ls -d "$DBROOT"/interproscan/interproscan-* 2>/dev/null | head -1 || true)
    # Bakta/EggNOG: set both the native tool var (read by the tool + runner at run
    # time) and the SSIGN_-prefixed alias (the name `ssign doctor` looks up); ECOD
    # and InterProScan already use the SSIGN_ name for both. Without the aliases,
    # doctor can't find Bakta/EggNOG under --containall (no ~/.ssign marker mounted).
    [ -d "$DBROOT/bakta" ]           && export APPTAINERENV_BAKTA_DB="$DBROOT/bakta" APPTAINERENV_SSIGN_BAKTA_DB="$DBROOT/bakta"
    [ -d "$DBROOT/eggnog" ]          && export APPTAINERENV_EGGNOG_DATA_DIR="$DBROOT/eggnog" APPTAINERENV_SSIGN_EGGNOG_DB="$DBROOT/eggnog"
    [ -n "$_ecod" ]                  && export APPTAINERENV_SSIGN_ECOD_DB="$_ecod"
    [ -n "$_ips" ]                   && export APPTAINERENV_SSIGN_INTERPROSCAN_PATH="$_ips"
    [ -d "$DBROOT/blast_swissprot" ] && export APPTAINERENV_SSIGN_BLAST_SWISSPROT="$DBROOT/blast_swissprot"
fi

# --- DTU predictors ---------------------------------------------------------
# DeepLocPro is baked into the image; pass --deeplocpro-env only to override it.
# SignalP is host-provided: use --signalp-env, or we auto-detect a conda env that
# holds signalp6 (the same roots the runner scans), so no flag is needed after
# ssign-setup-dtu. If none is found, ssign stops at the SignalP step with install
# instructions unless you add `-- --signalp-mode remote`.
DTU_ARGS=()
if [ -n "$DLPENV" ]; then
    DLPENV=$(readlink -f "$DLPENV")
    [ -x "$DLPENV/bin/deeplocpro" ] || die "no bin/deeplocpro in --deeplocpro-env: $DLPENV"
    BINDS+=( -B "$DLPENV":"$DLPENV":ro )
    DTU_ARGS+=( --deeplocpro-mode local --deeplocpro-path "$DLPENV/bin" )
fi
if [ -z "$SP6ENV" ]; then
    for _root in ~/.conda/envs ~/miniconda3/envs ~/anaconda3/envs ~/miniforge3/envs ~/mambaforge/envs ~/micromamba/envs; do
        for _d in "$_root"/*/; do
            if [ -x "${_d}bin/signalp6" ]; then SP6ENV="${_d%/}"; break 2; fi
        done
    done
    [ -n "$SP6ENV" ] && echo "ssign-run: auto-detected SignalP env $SP6ENV"
fi
if [ -n "$SP6ENV" ]; then
    SP6ENV=$(readlink -f "$SP6ENV")
    [ -x "$SP6ENV/bin/signalp6" ] || die "no bin/signalp6 in --signalp-env: $SP6ENV"
    BINDS+=( -B "$SP6ENV":"$SP6ENV":ro )
    DTU_ARGS+=( --signalp-mode local --signalp-path "$SP6ENV/bin" )
    # doctor reads the SSIGN_SIGNALP_PATH env var (not the run-only flag above),
    # so set it too and its optional SignalP check finds the local install.
    export APPTAINERENV_SSIGN_SIGNALP_PATH="$SP6ENV/bin"
fi

# --- doctor: verify the install and exit ------------------------------------
# BINDS now holds the DB root + its SSIGN_* path env vars and the SignalP env,
# which is everything doctor inspects. exec here so the run-only scratch/genome/
# GPU/RAM setup below is skipped. Same --containall as a real run, so this
# verifies exactly what a run would see.
if [ "$DOCTOR" -eq 1 ]; then
    echo "ssign-run: doctor  tier=$TIER  image=$SIF"
    [ -n "$DBROOT" ] && echo "ssign-run: db-root=$DBROOT"
    # doctor finds the databases via a db_root marker at its --data-root. Inside
    # the container $HOME is the image's own home, and the marker fetch-databases
    # writes there (unbound) does not persist to the host, so doctor's default
    # ~/.ssign lookup misses it and reports every DB missing. Record the marker on
    # the host from --db-root and point doctor at it. (A native install writes this
    # marker directly on the host, so it persists there on its own.)
    DR_ARGS=()
    if [ -n "$DBROOT" ]; then
        mkdir -p "$HOME/.ssign"
        printf '%s\n' "$DBROOT" > "$HOME/.ssign/db_root"
        BINDS+=( -B "$HOME/.ssign":"$HOME/.ssign":ro )
        DR_ARGS=( --data-root "$HOME/.ssign" )
    fi
    exec apptainer run --writable-tmpfs --containall "${BINDS[@]}" \
        "$SIF" doctor --tier "$TIER" "${DR_ARGS[@]}" "${PASSTHRU[@]}"
fi

# --- scratch + (optional) torch cache --------------------------------------
# Bind real-disk scratch onto /tmp and point TMPDIR there so Bakta/EggNOG/IPS
# temp files have room (the runner's scratch resolver keeps a roomy TMPDIR).
BINDS+=( -B "$SCRATCH":/tmp )
export APPTAINERENV_TMPDIR=/tmp
# DeepLocPro's ESM2 backbone is BAKED into the image, so the default localization
# path needs no torch-cache mount. Mount one only if asked (--torch-cache), e.g.
# to persist DeepSecE's (off-by-default) ESM1b across runs. NOTE: a mount overlays
# the baked cache, so if you mount one it must also hold ESM2 for DeepLocPro.
if [ -n "$TORCH_CACHE" ]; then
    TORCH_CACHE=$(readlink -f "$TORCH_CACHE"); mkdir -p "$TORCH_CACHE"
    BINDS+=( -B "$TORCH_CACHE":/opt/ssign_home/.cache/torch )
fi
BINDS+=( -B "$GENOME":/work/in.gbff:ro -B "$OUTDIR":/work/out )

# --- RAM budget -------------------------------------------------------------
# Under --containall ssign cannot see the scheduler's RAM allocation (no qstat;
# cgroup often reports the whole physical node), so its effective_ram_gb would
# size tool heaps and EggNOG --dbmem to the full node and risk OOM. Pass the job's
# RAM in explicitly. Priority: --max-ram > $SSIGN_MAX_RAM_GB > SLURM_MEM_PER_NODE.
if [ -z "$MAXRAM" ] && [ -n "${SLURM_MEM_PER_NODE:-}" ]; then
    MAXRAM=$(( SLURM_MEM_PER_NODE / 1024 ))   # scheduler reports MB; ssign wants GB
fi
[ -n "$MAXRAM" ] && export APPTAINERENV_SSIGN_MAX_RAM_GB="$MAXRAM"

# --- run --------------------------------------------------------------------
echo "ssign-run: tier=$TIER  image=$SIF  gpu=$([ "${#NV_FLAG[@]}" -gt 0 ] && echo yes || echo no)"
echo "ssign-run: genome=$GENOME"
echo "ssign-run: outdir=$OUTDIR  scratch=$SCRATCH"
[ -n "$DBROOT" ] && echo "ssign-run: db-root=$DBROOT"
[ -n "$MAXRAM" ] && echo "ssign-run: RAM budget SSIGN_MAX_RAM_GB=${MAXRAM} GB"
[ "${#DTU_ARGS[@]}" -gt 0 ] || echo "ssign-run: no local SignalP env found; DeepLocPro is baked, but the SignalP step will stop the run unless you install it (ssign-setup-dtu) or add '-- --signalp-mode remote'"

exec apptainer run "${NV_FLAG[@]}" --writable-tmpfs --containall "${BINDS[@]}" \
    "$SIF" run /work/in.gbff --outdir /work/out --tier "$TIER" \
    "${DTU_ARGS[@]}" "${PASSTHRU[@]}"
