#!/bin/bash
# ssign multi-genome BATCHED-MODE PBS script.
#
# Runs ONE ssign invocation across N genomes inside a single PBS job so
# predictions and annotations get pooled across genomes (MultiGenomeRunner).
# Different from run_serial_genomes.pbs, which runs ssign N times back-to-back.
#
# Usage:
#   qsub -v "INPUT_GBFFS=$HOME/ssign-tutorial/ecoli_k12.gbff:$HOME/ssign-tutorial/pseudomonas_pao1.gbff" \
#        -l select=1:ncpus=64:mem=120gb:ngpus=1:gpu_type=L40S \
#        scripts/cx3/run_batched_multi.pbs
#
# Per-genome outputs land in $RUN_DIR/<sample_id>/; a top-level
# combined_results.csv aggregates all substrates with a source_genome column.

#PBS -l select=1:ncpus=64:mem=120gb:ngpus=1
#PBS -l walltime=16:00:00
#PBS -N ssign_batched
#PBS -j oe
#PBS -o ssign_batched.log
#PBS -S /bin/bash

set -eo pipefail

: "${INPUT_GBFFS:?Pass via -v INPUT_GBFFS=path1:path2:path3 ... (colon-separated)}"
IFS=':' read -ra GENOME_LIST <<<"$INPUT_GBFFS"
for g in "${GENOME_LIST[@]}"; do
    test -f "$g" || { echo "FATAL: input not found: $g"; exit 1; }
done

: "${GPU_TYPE:=L40S}"
# Include PBS_JOBID so simultaneously-released jobs in the same second
# don't collide on the same RUN_DIR and clobber each other's outputs.
# Without it, an overnight batch where N jobs land in <1s gives N-K
# silently-overwritten output dirs, where K is the number of distinct
# seconds the jobs started in.
RUN_DIR="$HOME/runs/batched_${GPU_TYPE}_$(date +%Y%m%d_%H%M%S)_${PBS_JOBID%%.*}"
VENV="$HOME/blastp_t5a/ssign/.venv"

mkdir -p "$RUN_DIR" && cd "$RUN_DIR"

echo "===== BATCHED JOB START $(date -Is) | $(hostname) | $PBS_JOBID ====="
echo "Processing ${#GENOME_LIST[@]} genome(s):"
for g in "${GENOME_LIST[@]}"; do echo "  $g"; done

nvidia-smi || { echo "FATAL: no GPU"; exit 1; }

source ~/.bashrc 2>/dev/null || true
module load Java/11.0.25 || { echo "FATAL: Java/11.0.25 module unavailable. Check 'module avail Java'."; exit 1; }

source "$VENV/bin/activate"
command -v ssign >/dev/null || { echo "FATAL: ssign not on PATH after venv activation."; exit 1; }
echo "  ssign -> $(command -v ssign)"

export PATH="$PATH:$HOME/.conda/envs/bakta-deps/bin"
export SSIGN_PLMBLAST_SCRIPT="$HOME/tools/pLM-BLAST/scripts/plmblast.py"
test -f "$SSIGN_PLMBLAST_SCRIPT" || { echo "FATAL: SSIGN_PLMBLAST_SCRIPT not found at $SSIGN_PLMBLAST_SCRIPT"; exit 1; }

# --- CX3 databases + local predictors --------------------------------------
# Databases live on $EPHEMERAL, which RCS PURGES after ~30 days of no access. If
# a job dies on a "requires --bakta-db / DB not found" error, re-fetch with the
# helper:  bash scripts/fetch_databases.sh --tier extended --target $EPHEMERAL/ssign-databases
# ssign reads these env vars directly (Config.__post_init__), so no CLI flags are
# needed; each is set only when its target exists. A present SSIGN_*_PATH makes
# that predictor run LOCALLY — REQUIRED on CX3 because compute nodes can't reach
# the remote DTU webserver.
DBROOT="$EPHEMERAL/ssign-databases"
[ -d "$DBROOT/bakta" ]                  && export BAKTA_DB="$DBROOT/bakta"
[ -d "$DBROOT/eggnog" ]                 && export EGGNOG_DATA_DIR="$DBROOT/eggnog"
[ -d "$DBROOT/plm_effector_weights" ]   && export SSIGN_PLM_EFFECTOR_WEIGHTS="$DBROOT/plm_effector_weights"
[ -d "$DBROOT/plm_blast/ECOD70" ]       && export SSIGN_ECOD_DB="$DBROOT/plm_blast/ECOD70"
[ -d "$DBROOT/hhsuite/pfam" ]           && export SSIGN_HHSUITE_PFAM="$DBROOT/hhsuite/pfam"
[ -d "$DBROOT/hhsuite/pdb70" ]          && export SSIGN_HHSUITE_PDB70="$DBROOT/hhsuite/pdb70"
_IPS=$(ls -d "$DBROOT"/interproscan/interproscan-* 2>/dev/null | head -1)
[ -n "$_IPS" ]                          && export SSIGN_INTERPROSCAN_PATH="$_IPS"
[ -d "$HOME/.conda/envs/deeplocpro/bin" ] && export SSIGN_DEEPLOCPRO_PATH="$HOME/.conda/envs/deeplocpro/bin"
[ -d "$HOME/.conda/envs/signalp6/bin" ]   && export SSIGN_SIGNALP_PATH="$HOME/.conda/envs/signalp6/bin"
echo "  BAKTA_DB=${BAKTA_DB:-<unset: Bakta will fail unless --use-input-annotations>}"
echo "  local predictors: DLP=${SSIGN_DEEPLOCPRO_PATH:-remote} SignalP=${SSIGN_SIGNALP_PATH:-remote}"

echo "===== ssign run START $(date -Is) ====="
# SSIGN_EXTRA_ARGS appends additional ssign flags. Word-splits on
# whitespace, so multiple flags work. Pass via
#   qsub -v INPUT_GBFFS=...,SSIGN_EXTRA_ARGS="--no-combined-summary" ...
: "${SSIGN_EXTRA_ARGS:=}"
echo "extra args: $SSIGN_EXTRA_ARGS"
ssign run "${GENOME_LIST[@]}" \
    --outdir "$RUN_DIR" \
    --tier extended \
    $SSIGN_EXTRA_ARGS \
    2>&1 | tee "$RUN_DIR/ssign.run.log"
SSIGN_RC=${PIPESTATUS[0]}
echo "===== ssign run END (rc=$SSIGN_RC) $(date -Is) ====="

echo "===== Output layout ====="
ls -la "$RUN_DIR"
test -f "$RUN_DIR/combined_results.csv" && echo "combined_results.csv: $(wc -l < "$RUN_DIR/combined_results.csv") rows"

exit $SSIGN_RC
