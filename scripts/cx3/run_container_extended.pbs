#!/bin/bash
# ssign EXTENDED-tier CONTAINER validation PBS script (self-contained image).
#
# Runs ONE genome through the Singularity/Apptainer image (.sif) at extended
# tier. As of the ssign_v4.sif image, the free toolchain is BAKED: Bakta 1.12.0
# + its binary deps (tRNAscan-SE, aragorn, INFERNAL, PilerCR, AMRFinderPlus,
# DIAMOND, real HMMER, BLAST+ 2.17), EggNOG's emapper.py, AND DeepLocPro + its
# ESM2 backbone. So this script mounts ONLY what genuinely can't be baked:
#   * SignalP 6 — the ONLY predictor still host-provided (DTU academic licence)
#   * reference databases (Bakta DB, EggNOG DB, InterProScan install, ECOD, Swiss-Prot)
# No host bakta-deps / eggnog / deeplocpro conda env, no crafted PREPEND_PATH, no
# torch-cache mount (ESM2 is baked): the image supplies the tools. This is the
# reproducible-install task 5.3 parity check for the self-contained image (5.4/5.7).
#
# Usage. gpu_type=RTX6000 is baked into the #PBS directive below (it is MANDATORY
# on v1_gpu72 — a GPU request without it queues FOREVER with "Placement set is too
# small"). Submit with a SHORT, SINGLE-LINE qsub passing only -v (a multi-line
# qsub gets its -l line swallowed by terminal auto-indent on paste, which drops
# gpu_type and wedges the job):
#   qsub -v GENOME=$HOME/xantho_gbff/GCF_000.gbff,SIF=$EPHEMERAL/ssign_v4.sif ~/blastp_t5a/ssign/scripts/cx3/run_container_extended.pbs
#
# Pick GENOME as a real annotated genome that yields >=1 substrate: the minimal
# T5aSS fixture localizes 0 substrates on CX3's DeepLocPro, which would leave the
# annotation tools (EggNOG/InterProScan/pLM-BLAST) with nothing to run on.

#PBS -l select=1:ncpus=32:mem=64gb:ngpus=1:gpu_type=RTX6000
#PBS -l walltime=06:00:00
#PBS -N ssign_container_ext
#PBS -j oe
#PBS -o ssign_container_ext.log
#PBS -S /bin/bash

set -eo pipefail

: "${GENOME:?Pass via -v GENOME=/abs/path/genome.gbff}"
: "${SIF:=$EPHEMERAL/ssign_v4.sif}"
: "${TIER:=extended}"
test -f "$GENOME" || { echo "FATAL: genome not found: $GENOME"; exit 1; }
test -f "$SIF"    || { echo "FATAL: image not found: $SIF"; exit 1; }

RUN_DIR="$HOME/runs/container_${TIER}_$(date +%Y%m%d_%H%M%S)_${PBS_JOBID%%.*}"
mkdir -p "$RUN_DIR" && cd "$RUN_DIR"

echo "===== CONTAINER $TIER JOB START $(date -Is) | $(hostname) | $PBS_JOBID ====="
echo "  genome: $GENOME"
echo "  image:  $SIF"
nvidia-smi || { echo "FATAL: no GPU"; exit 1; }
command -v apptainer >/dev/null || module load apptainer 2>/dev/null || true
command -v apptainer >/dev/null || { echo "FATAL: apptainer not available"; exit 1; }
echo "  apptainer -> $(apptainer --version)"

# --- host-provided databases + DTU predictors (only the un-bakeable bits) ----
DBROOT="$EPHEMERAL/ssign-databases"
SP6ENV="$HOME/.conda/envs/signalp6"  # SignalP 6 — the only predictor not baked
_ECOD=$(ls -d "$DBROOT"/plm_blast/ECOD* 2>/dev/null | head -1 || true)
_IPS=$(ls -d "$DBROOT"/interproscan/interproscan-* 2>/dev/null | head -1 || true)

# ssign reads these INSIDE the container. Under --containall the host env is not
# forwarded, so use the APPTAINERENV_ prefix (Apptainer strips it and sets the
# bare var inside). Each is set only when its target exists on the host. NOTE:
# EGGNOG_DATA_DIR points at the host DB — emapper.py itself is baked, but its
# ~50 GB database is not; likewise SSIGN_INTERPROSCAN_PATH is the host IPS install
# (member DBs), which also supplies interproscan.sh (IPS is not baked).
[ -d "$DBROOT/bakta" ]           && export APPTAINERENV_BAKTA_DB="$DBROOT/bakta"
[ -d "$DBROOT/eggnog" ]          && export APPTAINERENV_EGGNOG_DATA_DIR="$DBROOT/eggnog"
[ -n "$_ECOD" ]                  && export APPTAINERENV_SSIGN_ECOD_DB="$_ECOD"
[ -n "$_IPS" ]                   && export APPTAINERENV_SSIGN_INTERPROSCAN_PATH="$_IPS"
[ -d "$DBROOT/blast_swissprot" ] && export APPTAINERENV_SSIGN_BLAST_SWISSPROT="$DBROOT/blast_swissprot"

# --- bind mounts ------------------------------------------------------------
# $DBROOT is rw (no :ro): InterProScan's launcher writes scratch under its own
# install dir. SignalP env is ro (invoked at its real host path so its shebang +
# bundled libs resolve). No DeepLocPro mount and no torch-cache mount — DeepLocPro
# and its ESM2 backbone are baked into the image.
BINDS=( -B "$DBROOT":"$DBROOT" )
[ -d "$SP6ENV" ] && BINDS+=( -B "$SP6ENV":"$SP6ENV":ro )
BINDS+=( -B "$GENOME":/work/in.gbff:ro -B "$RUN_DIR":/work/out )
# Bind the PBS node-local scratch (real SSD) onto /tmp and point TMPDIR at it.
# The runner's Phase-1 scratch fix already reroutes tempfile to real disk, so this
# is now a PERFORMANCE choice (fast node-local SSD for Bakta/EggNOG/IPS temp)
# rather than the load-bearing fix for the 64 MiB --writable-tmpfs /tmp.
SCRATCH="${TMPDIR:-$EPHEMERAL/ssign_ctr_scratch}"; mkdir -p "$SCRATCH"
BINDS+=( -B "$SCRATCH":/tmp )
export APPTAINERENV_TMPDIR=/tmp

echo "  DeepLocPro: BAKED IN IMAGE (+ ESM2 weights)"
echo "  SignalP=$SP6ENV"
echo "  Bakta+EggNOG: BAKED IN IMAGE (no host conda env mounted)"
echo "  EggNOG DB=${DBROOT}/eggnog  ECOD=${_ECOD:-<none>}  IPS=${_IPS:-<none>}"

echo "===== apptainer run START $(date -Is) ====="
apptainer run --nv --writable-tmpfs --containall "${BINDS[@]}" \
    "$SIF" run /work/in.gbff --outdir /work/out --tier "$TIER" \
    --signalp-mode local --signalp-path "$SP6ENV/bin" \
    2>&1 | tee "$RUN_DIR/ssign.run.log"
RC=${PIPESTATUS[0]}
echo "===== apptainer run END (rc=$RC) $(date -Is) ====="

echo "===== Output layout ====="
ls -la "$RUN_DIR"
exit $RC
